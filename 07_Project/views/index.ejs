<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
    <div class="w-ful min-h-screen bg-zinc-900 p-10 text-white">
        <h3 class="text-3xl mb-5">Create User</h3>
        <form action="/register" method="post">
            <input class="px-3 py-2 rounded-lg bg-transparent border-2" type="text" placeholder="name"name="name" >
            <input class="px-3 py-2 rounded-lg bg-transparent border-2" type="text" placeholder="username"name="username" >
            <input class="px-3 py-2 rounded-lg bg-transparent border-2" type="number" placeholder="age"name="age" >
            <input class="px-3 py-2 rounded-lg bg-transparent border-2" type="email" placeholder="email"name="email" >
            <input class="px-3 py-2 rounded-lg bg-transparent border-2" type="password" placeholder="password"name="password" >
            <input class="px-5 py-2 rounded-lg bg-blue-500" type="submit" value="Create Accont" >
        </form>
    </div>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
    <div class="w-full h-screen bg-zinc-900 text-white p-10">
        <h3 class="text-3xl mb-3">Login Your Account</h3>
      <form action="/login" method="post">
       <input class="px-3 py-2 rounded-lg bg-transparent border-2 " type="email" placeholder="email" name="email">
       <input class="px-3 py-2 rounded-lg bg-transparent border-2 " type="password" placeholder="password" name="password">
       <input class="bg-blue-500 rounded-lg px-5 py-2" type="submit" value="Login">

      </form>

    </div>
    
</body>
</html>